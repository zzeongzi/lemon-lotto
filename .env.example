# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
ADMIN_USER_ID=your_discord_user_id_here

# Blink API Configuration (GraphQL)
BLINK_API_URL=https://api.blink.sv/graphql
BLINK_API_KEY=your_blink_api_key_here
BLINK_WALLET_ID=your_btc_wallet_id_here
BLINK_DONATE_WALLET_ID=your_donate_wallet_id_here

# Game Settings
TICKET_PRICE=1
MAX_TICKETS_PER_USER=5
MAX_TOTAL_TICKETS=2100
FEE_PERCENTAGE=1

# Optional: Database
DB_PATH=lotto.dbgit add .env.example